          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.environment.set('taskId', json.id);",
                  "if (json.columnId) pm.environment.set('sourceColumnId', json.columnId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Testar AllanFlow via Postman\",\n  \"description\": \"Tarefa criada pela collection do Postman.\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-07-31T09:24:00\",\n  \"labels\": [\"{{labelId}}\"],\n  \"assignees\": [\"{{userId}}\"],\n  \"client\": \"{{clientId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
